{
  "version": 8,
  "name": "City streets",
  "metadata": {
    "description": "The street centerline network, weighted by the source Class code (arterials heavier)."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../streets.pmtiles"
    }
  },
  "layers": [
    {
      "id": "line",
      "type": "line",
      "source": "data",
      "source-layer": "streets",
      "paint": {
        "line-color": "#174054",
        "line-width": [
          "match",
          [
            "get",
            "Class"
          ],
          "A31",
          3.0,
          "A41",
          1.2,
          "A61",
          2.0,
          "A62",
          2.0,
          "A63",
          2.0,
          "A73",
          2.4,
          1.0
        ],
        "line-opacity": 1.0
      }
    }
  ]
}
