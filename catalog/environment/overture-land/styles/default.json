{
  "version": 8,
  "name": "Land by subtype",
  "metadata": {
    "description": "Physical land surfaces from OSM natural tags \u2014 forest, shrub, grass, sand, rock, wetland as polygons, and 61,000 individual trees as green points. The trees live at z13+ in the tiles \u2014 zoom in to see them."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-07-22.0/base.pmtiles"
    }
  },
