{
  "version": 8,
  "name": "Trees",
  "metadata": {
    "description": "Only the trees \u2014 every individually mapped tree in the box as a green point, OSM's answer to the city's Forestry inventory."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-07-22.0/base.pmtiles"
    }
  },
  "layers": [
    {
      "id": "land-circle",
      "type": "circle",
      "source": "data",
      "source-layer": "land",
      "paint": {
        "circle-color": "#538400",
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          14,
          2.5,
          16,
          4
        ],
        "circle-opacity": 0.85
      },
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "Point"
        ],
        [
          "==",
          [
            "get",
            "subtype"
          ],
          "tree"
        ]
      ]
    }
  ]
}
