{
  "version": 8,
  "name": "City schools",
  "metadata": {
    "description": "The 133 school locations, labeled."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../schools.pmtiles"
    }
  },
  "layers": [
    {
      "id": "circle",
      "type": "circle",
      "source": "data",
      "source-layer": "schools",
      "paint": {
        "circle-color": "#1e526b",
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1.6,
          13,
          4,
          16,
          8.8
        ],
        "circle-opacity": 0.85,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 0.5
      }
    },
    {
      "id": "labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "schools",
      "minzoom": 12,
      "layout": {
        "text-field": [
          "get",
          "USER_School_Name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    }
  ],
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf"
}
