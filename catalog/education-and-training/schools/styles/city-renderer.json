{
  "version": 8,
  "name": "City renderer",
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../schools.pmtiles"
    }
  },
  "layers": [
    {
      "id": "schools-legend",
      "type": "fill",
      "source": "data",
      "source-layer": "schools",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "USER_School_System"
          ],
          "Charter",
          "#808080",
          "Independent",
          "#808080",
          "Parochial",
          "#808080",
          "Public",
          "#808080",
          "Public - Alternative",
          "#808080",
          "Public - College & Career Readiness",
          "#808080",
          "Public - ESOL",
          "#808080",
          "Public - Early Childood Center",
          "#808080",
          "Public - Special Education",
          "#808080",
          "#cccccc"
        ],
        "fill-opacity": 0
      }
    },
    {
      "id": "categorical-circle",
      "type": "circle",
      "source": "data",
      "source-layer": "schools",
      "paint": {
        "circle-color": [
          "match",
          [
            "get",
            "USER_School_System"
          ],
          "Charter",
          "#808080",
          "Independent",
          "#808080",
          "Parochial",
          "#808080",
          "Public",
          "#808080",
          "Public - Alternative",
          "#808080",
          "Public - College & Career Readiness",
          "#808080",
          "Public - ESOL",
          "#808080",
          "Public - Early Childood Center",
          "#808080",
          "Public - Special Education",
          "#808080",
          "#cccccc"
        ],
        "circle-radius": 5,
        "circle-opacity": 1.0
      }
    }
  ],
  "metadata": {
    "description": "The city's own symbology, extracted from the source ArcGIS renderer."
  }
}
