{
  "version": 8,
  "name": "Blocks by census tract (2010)",
  "metadata": {
    "description": "Blocks tinted by 2010 census tract (CensTract10, repeating colors), labeled with the block number.",
    "legend": "none"
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../city-blocks.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "city-blocks",
      "paint": {
        "fill-color": [
          "match",
          [
            "%",
            [
              "to-number",
              [
                "get",
                "CensTract10"
              ]
            ],
            14
          ],
          0,
          "#7fb3d0",
          1,
          "#e2a76f",
          2,
          "#95c68f",
          3,
          "#d98d8d",
          4,
          "#a99bd0",
          5,
          "#c9b970",
          6,
          "#8fc6c0",
          7,
          "#d093b5",
          8,
          "#b0a377",
          9,
          "#9cb0e0",
          10,
          "#e0b394",
          11,
          "#88b8a3",
          12,
          "#c99ac0",
          13,
          "#adc487",
          "#9aa3a8"
        ],
        "fill-opacity": 0.65,
        "fill-outline-color": "#FFFFFF"
      }
    },
    {
      "id": "line",
      "type": "line",
      "source": "data",
      "source-layer": "city-blocks",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": 0.6,
        "line-opacity": 1.0
      }
    },
    {
      "id": "labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "city-blocks",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "get",
          "Name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    }
  ]
}
