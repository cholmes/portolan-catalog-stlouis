{
  "version": 8,
  "name": "Neighborhoods",
  "metadata": {
    "description": "The 88 official neighborhoods, each tinted from a repeating ten-color set so adjacent neighborhoods read apart, with name labels. Colors carry no meaning.",
    "legend": "none"
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../neighborhoods.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "neighborhoods",
      "paint": {
        "fill-color": [
          "match",
          [
            "%",
            [
              "get",
              "NHD_NUM"
            ],
            10
          ],
          0,
          "#7fb3d0",
          1,
          "#e2a76f",
          2,
          "#95c68f",
          3,
          "#d98d8d",
          4,
          "#a99bd0",
          5,
          "#c9b970",
          6,
          "#8fc6c0",
          7,
          "#d093b5",
          8,
          "#b0a377",
          9,
          "#9cb0e0",
          "#9aa3a8"
        ],
        "fill-opacity": 0.65,
        "fill-outline-color": "#FFFFFF"
      }
    },
    {
      "id": "line",
      "type": "line",
      "source": "data",
      "source-layer": "neighborhoods",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": 1.2,
        "line-opacity": 1.0
      }
    },
    {
      "id": "labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "neighborhoods",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "get",
          "NHD_NAME"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    }
  ],
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf"
}
