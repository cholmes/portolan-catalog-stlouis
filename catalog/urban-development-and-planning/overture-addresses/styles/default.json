{
  "version": 8,
  "name": "Address points",
  "metadata": {
    "description": "Every address point in the box, in the catalog blue. Overture has no address data for the city proper yet, so the points ring it \u2014 the county and Illinois fringe. Thinned at overview zooms, complete from z14."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../overture-addresses.pmtiles"
    }
  },
  "layers": [
    {
      "id": "overture-addresses-circle",
      "type": "circle",
      "source": "data",
      "source-layer": "overture-addresses",
      "paint": {
        "circle-color": "#1e526b",
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          13,
          1.5,
          17,
          4
        ],
        "circle-opacity": 0.85,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 0.5
      }
    }
  ]
}
