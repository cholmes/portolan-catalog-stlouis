{
  "version": 8,
  "name": "City renderer",
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../historic-districts.pmtiles"
    }
  },
  "layers": [
    {
      "id": "categorical-fill",
      "type": "fill",
      "source": "data",
      "source-layer": "historic-districts",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "DIS_TYPE"
          ],
          "National",
          "#ff0000",
          "Landmark",
          "#005ce6",
          "Certified Local",
          "#ffaa00",
          "Local",
          "#c6e2b2",
          "#cccccc"
        ],
        "fill-opacity": [
          "match",
          [
            "get",
            "DIS_TYPE"
          ],
          "National",
          0.0,
          "Landmark",
          0.6,
          "Certified Local",
          0.6,
          "Local",
          0.6,
          0
        ]
      }
    },
    {
      "id": "historic-districts-outline",
      "type": "line",
      "source": "data",
      "source-layer": "historic-districts",
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "DIS_TYPE"
          ],
          "National",
          "#a80000",
          "Landmark",
          "#000000",
          "Certified Local",
          "#000000",
          "Local",
          "#000000",
          "#9aa3a8"
        ],
        "line-width": [
          "match",
          [
            "get",
            "DIS_TYPE"
          ],
          "National",
          1.33,
          "Landmark",
          0.67,
          "Certified Local",
          0.67,
          "Local",
          0.67,
          1
        ]
      }
    }
  ],
  "metadata": {
    "description": "The city's own symbology, extracted from the source ArcGIS renderer."
  }
}
