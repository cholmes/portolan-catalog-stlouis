{
  "version": 8,
  "name": "National Register sites",
  "metadata": {
    "description": "Just the NR-listed sites."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../historic-landmarks.pmtiles"
    }
  },
  "layers": [
    {
      "id": "historic-landmarks-legend",
      "type": "fill",
      "source": "data",
      "source-layer": "historic-landmarks",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "SITE_TYPE"
          ],
          "NR_SITE",
          "#1e526b",
          "#00000000"
        ],
        "fill-opacity": 0
      }
    },
    {
      "id": "circle",
      "type": "circle",
      "source": "data",
      "source-layer": "historic-landmarks",
      "paint": {
        "circle-color": [
          "match",
          [
            "get",
            "SITE_TYPE"
          ],
          "NR_SITE",
          "#1e526b",
          "#00000000"
        ],
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1.6,
          13,
          4,
          16,
          8.8
        ],
        "circle-opacity": 0.85
      }
    }
  ]
}
