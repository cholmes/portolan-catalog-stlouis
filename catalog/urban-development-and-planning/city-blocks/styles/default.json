{
  "version": 8,
  "name": "City blocks",
  "metadata": {
    "description": "Every numbered block as a readable unit: semi-transparent city-blue fill, white borders, and the block number labeled at high zoom."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../city-blocks.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "city-blocks",
      "paint": {
        "fill-color": "#5b8db0",
        "fill-opacity": 0.45,
        "fill-outline-color": "#FFFFFF"
      }
    },
    {
      "id": "line",
      "type": "line",
      "source": "data",
      "source-layer": "city-blocks",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": 1.0,
        "line-opacity": 1.0
      }
    },
    {
      "id": "labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "city-blocks",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "get",
          "Name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    }
  ],
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf"
}
