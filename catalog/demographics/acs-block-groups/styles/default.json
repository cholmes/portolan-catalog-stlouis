{
  "version": 8,
  "name": "Median household income",
  "metadata": {
    "description": "Median household income per block group, light to dark blue \u2014 the city's north\u2013south income divide in one layer. Block groups whose estimate is too noisy to trust (coefficient of variation over 0.30) render faded; the income is real but the margin of error swamps it."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../acs-block-groups.pmtiles"
    }
  },
  "layers": [
    {
      "id": "acs-block-groups-legend",
      "type": "fill",
      "source": "data",
      "source-layer": "acs-block-groups",
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "median_hh_income"
          ],
          "#eef3f6",
          30000,
          "#c6dbe8",
          45000,
          "#8fbdd6",
          60000,
          "#5591b5",
          80000,
          "#2d6a8e",
          110000,
          "#174054"
        ],
        "fill-opacity": 0
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "acs-block-groups",
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "median_hh_income"
          ],
          "#eef3f6",
          30000,
          "#c6dbe8",
          45000,
          "#8fbdd6",
          60000,
          "#5591b5",
          80000,
          "#2d6a8e",
          110000,
          "#174054"
        ],
        "fill-opacity": [
          "case",
          [
            ">",
            [
              "coalesce",
              [
                "get",
                "median_hh_income_cv"
              ],
              0
            ],
            0.3
          ],
          0.3,
          0.8
        ],
        "fill-outline-color": "#666666"
      },
      "filter": [
        "has",
        "median_hh_income"
      ]
    },
    {
      "id": "line",
      "type": "line",
      "source": "data",
      "source-layer": "acs-block-groups",
      "paint": {
        "line-color": "#666666",
        "line-width": 0.3,
        "line-opacity": 1.0
      }
    }
  ]
}
