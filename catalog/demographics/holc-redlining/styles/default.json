      "id": "holc-redlining-legend",
      "type": "fill",
      "source": "data",
      "source-layer": "holc-redlining",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "grade"
          ],
          "A",
          "#76a865",
          "B",
          "#7cb5bd",
          "C",
          "#ffff00",
          "D",
          "#d9838d",
          "#9aa3a8"
        ],
        "fill-opacity": 0
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "holc-redlining",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "grade"
          ],
          "A",
          "#76a865",
          "B",
          "#7cb5bd",
          "C",
          "#ffff00",
          "D",
          "#d9838d",
          "#9aa3a8"
        ],
        "fill-opacity": 0.6,
