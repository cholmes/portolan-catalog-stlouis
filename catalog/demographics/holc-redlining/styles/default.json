{
  "version": 8,
  "name": "HOLC grade (1930s)",
  "metadata": {
    "description": "The 1930s Home Owners' Loan Corporation security grades in the original map's own colors: A \"Best\" (green), B \"Still Desirable\" (blue), C \"Definitely Declining\" (yellow), D \"Hazardous\" (red) \u2014 the redlined areas. One ungraded polygon renders gray."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../holc-redlining.pmtiles"
    }
  },
  "layers": [
