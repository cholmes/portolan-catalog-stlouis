{
  "version": 8,
  "name": "Labeled zones",
  "metadata": {
    "description": "Zones with their district names."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../opportunity-zones.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
