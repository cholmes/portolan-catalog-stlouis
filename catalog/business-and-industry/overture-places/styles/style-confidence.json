{
  "version": 8,
  "name": "Confidence",
  "metadata": {
    "description": "Overture's confidence that each place exists and is current, stepped from pale gray (below 0.5) to dark blue (0.9 and up)."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-07-22.0/places.pmtiles"
    }
  },
  "layers": [
    {
      "id": "overture-places-legend",
      "type": "fill",
      "source": "data",
      "source-layer": "place",
      "paint": {
        "fill-color": [
          "step",
          [
            "to-number",
            [
              "get",
              "confidence"
            ]
          ],
          "#c9d2d6",
          0.5,
          "#a8d4e8",
          0.75,
          "#5591b5",
          0.9,
          "#174054"
        ],
        "fill-opacity": 0
      }
    },
    {
      "id": "place-circle",
      "type": "circle",
      "source": "data",
      "source-layer": "place",
      "paint": {
        "circle-color": [
          "step",
          [
            "to-number",
            [
              "get",
              "confidence"
            ]
          ],
          "#c9d2d6",
          0.5,
          "#a8d4e8",
          0.75,
          "#5591b5",
          0.9,
          "#174054"
        ],
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          2.5,
          16,
          5
        ],
        "circle-opacity": 0.85,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 0.5
      }
    }
  ]
}
