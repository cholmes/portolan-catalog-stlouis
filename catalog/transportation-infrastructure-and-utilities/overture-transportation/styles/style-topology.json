{
  "version": 8,
  "name": "Segments and connectors",
  "metadata": {
    "description": "The routing graph itself: segments in light gray with every connector (intersection) as a red point. Connectors only tile at z13+ \u2014 zoom in."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-07-22.0/transportation.pmtiles"
    }
  },
  "layers": [
    {
      "id": "segment-line",
      "type": "line",
      "source": "data",
      "source-layer": "segment",
      "paint": {
        "line-color": "#9aa3a8",
        "line-width": 1.2,
        "line-opacity": 0.7
      }
    },
    {
      "id": "connector-circle",
      "type": "circle",
      "source": "data",
      "source-layer": "connector",
      "paint": {
        "circle-color": "#c03221",
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          1.5,
          16,
          3.5
        ],
        "circle-opacity": 0.85,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 0.5
      }
    }
  ]
}
