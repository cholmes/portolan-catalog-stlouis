{
  "version": 8,
  "name": "Street permits by neighborhood",
  "metadata": {
    "description": "Street-permit records aggregated to neighborhoods (the source lists neighborhood names, not parcels): count of permits per neighborhood."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../street-permits.pmtiles"
    }
  },
  "layers": [
    {
      "id": "street-permits-legend",
      "type": "fill",
      "source": "data",
      "source-layer": "street-permits",
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "n_permits"
          ],
          "#eef3f6",
          50,
          "#c6dbe8",
          250,
          "#8fbdd6",
          750,
          "#5591b5",
          1500,
          "#174054"
        ],
        "fill-opacity": 0
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "street-permits",
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "n_permits"
          ],
          "#eef3f6",
          50,
          "#c6dbe8",
          250,
          "#8fbdd6",
          750,
          "#5591b5",
          1500,
          "#174054"
        ],
        "fill-opacity": 0.75,
        "fill-outline-color": "#FFFFFF"
      }
    },
    {
      "id": "line",
      "type": "line",
      "source": "data",
      "source-layer": "street-permits",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": 0.8,
        "line-opacity": 1.0
      }
    }
  ]
}
