{
  "version": 8,
  "name": "ZIP codes",
  "metadata": {
    "description": "The 30 ZIP code areas touching the city, repeating colors, labeled.",
    "legend": "none"
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../zip-codes.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "zip-codes",
      "paint": {
        "fill-color": [
          "match",
          [
            "%",
            [
              "to-number",
              [
                "get",
                "ZIP"
              ]
            ],
            10
          ],
          0,
          "#7fb3d0",
          1,
          "#e2a76f",
          2,
          "#95c68f",
          3,
          "#d98d8d",
          4,
          "#a99bd0",
          5,
          "#c9b970",
          6,
          "#8fc6c0",
          7,
          "#d093b5",
          8,
          "#b0a377",
          9,
          "#9cb0e0",
          "#9aa3a8"
        ],
        "fill-opacity": 0.55,
        "fill-outline-color": "#FFFFFF"
      }
    },
    {
      "id": "line",
      "type": "line",
      "source": "data",
      "source-layer": "zip-codes",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": 1.0,
        "line-opacity": 1.0
      }
    },
    {
      "id": "labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "zip-codes",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "get",
          "ZIP"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    }
  ]
}
