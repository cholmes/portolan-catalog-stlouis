{
  "version": 8,
  "name": "ZIP codes labeled",
  "metadata": {
    "description": "The 30 ZIP code areas touching the city, each labeled with its code.",
    "legend": "none"
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../zip-codes.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "zip-codes",
      "paint": {
        "fill-color": "#a8d4e8",
        "fill-opacity": 0.35,
        "fill-outline-color": "#174054"
      }
    },
    {
      "id": "line",
      "type": "line",
      "source": "data",
      "source-layer": "zip-codes",
      "paint": {
        "line-color": "#174054",
        "line-width": 1.2,
        "line-opacity": 1.0
      }
    },
    {
      "id": "labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "zip-codes",
      "minzoom": 9,
      "layout": {
        "text-field": [
          "get",
          "ZCTA"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    }
  ],
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf"
}
