{
  "version": 8,
  "name": "Divisions by subtype",
  "metadata": {
    "description": "Division areas colored by their place in the hierarchy \u2014 counties orange, cities and municipalities blue, neighborhoods green \u2014 with shared boundaries drawn dark and each division's label point named. The country and region areas (bbox clips of the whole US, Missouri, and Illinois polygons) are in the data but not drawn here."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-07-22.0/divisions.pmtiles"
    }
  },
  "layers": [
    {
      "id": "overture-divisions-legend",
      "type": "fill",
      "source": "data",
      "source-layer": "division_area",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "county",
          "#e89d07",
          "locality",
          "#7fb3d0",
          "neighborhood",
          "#95c68f",
          "microhood",
          "#c98bab",
          "#9aa3a8"
        ],
        "fill-opacity": 0
      }
    },
    {
      "id": "division_area-fill",
      "type": "fill",
      "source": "data",
      "source-layer": "division_area",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "county",
          "#e89d07",
          "locality",
          "#7fb3d0",
          "neighborhood",
          "#95c68f",
          "microhood",
          "#c98bab",
          "#9aa3a8"
        ],
        "fill-opacity": 0.45,
        "fill-outline-color": "#FFFFFF"
      },
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "Polygon"
        ],
        [
          "match",
          [
            "get",
            "subtype"
          ],
          [
            "county",
            "locality",
            "neighborhood",
            "microhood"
          ],
          true,
          false
        ]
      ]
    },
    {
      "id": "division_boundary-line",
      "type": "line",
      "source": "data",
      "source-layer": "division_boundary",
      "paint": {
        "line-color": "#174054",
        "line-width": 1.6,
        "line-opacity": 1.0
      }
    },
    {
      "id": "division-labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "division",
      "minzoom": 9,
      "layout": {
        "text-field": [
          "get",
          "@name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    }
  ],
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf"
}
